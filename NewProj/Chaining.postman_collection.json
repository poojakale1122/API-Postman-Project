	"item": [
		{
			"name": "Create User",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var val =Math.random().toString(34).substring(1);\r",
							"var usermail=\"poo\"+val+\"@mail.com\";\r",
							"var usernamee=\"poo\"+val;\r",
							"\r",
							"pm.environment.set(\"usermail\", usermail);\r",
							"pm.environment.set(\"usernamee\", usernamee);\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonbody = pm.response.json();\r",
							"pm.environment.set(\"user_id\",jsonbody.id);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n\"name\": \"{{usernamee}}\",\r\n\"gender\": \"female\",\r\n\"status\": \"inactive\",\r\n\"email\": \"{{usermail}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://gorest.co.in/public/v2/users",

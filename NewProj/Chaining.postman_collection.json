		{
			"name": "Get List",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.response.to.have.status(200);\r",
							"pm.test(\"User ID matches\", () => {\r",
							"    var jsondata = pm.response.json();\r",
							"    pm.expect(jsondata.id).to.eql(pm.environment.get(\"user_id\"));\r",
							"    pm.expect(jsondata.email).to.eql(pm.environment.get(\"usermail\"));\r",
							"    pm.expect(jsondata.name).to.eql(pm.environment.get(\"usernamee\"));\r",
							"\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],

		{
			"name": "Misc Tests",
			"item": [
				{
					"name": "Schema Validation",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();\r",
									"\r",
									"// Load schema\r",
									"var schema = {\r",
									"    \"type\": \"object\",\r",
									"    \"required\": [\"products\", \"total\", \"skip\", \"limit\"],\r",
									"    \"properties\": {\r",
									"        \"products\": {\r",
									"            \"type\": \"array\",\r",
									"            \"minItems\": 1,\r",
									"            \"items\": {\r",
									"                \"type\": \"object\",\r",
									"                \"required\": [\"id\", \"title\", \"description\", \"category\", \"price\", \"stock\", \"rating\", \"images\", \"thumbnail\"],\r",
									"                \"properties\": {\r",
									"                    \"id\": { \"type\": \"integer\" },\r",
									"                    \"title\": { \"type\": \"string\" },\r",
									"                    \"description\": { \"type\": \"string\" },\r",
									"                    \"category\": { \"type\": \"string\" },\r",
									"                    \"price\": { \"type\": \"number\", \"minimum\": 0 },\r",
									"                    \"stock\": { \"type\": \"integer\", \"minimum\": 0 },\r",
									"                    \"rating\": { \"type\": \"number\", \"minimum\": 1, \"maximum\": 5 },\r",
									"                    \"images\": { \r",
									"                        \"type\": \"array\", \r",
									"                        \"items\": { \"type\": \"string\", \"format\": \"uri\" } \r",
									"                    },\r",
									"                    \"thumbnail\": { \"type\": \"string\", \"format\": \"uri\" }\r",
									"                }\r",
									"            }\r",
									"        },\r",
									"        \"total\": { \"type\": \"integer\" },\r",
									"        \"skip\": { \"type\": \"integer\" },\r",
									"        \"limit\": { \"type\": \"integer\" }\r",
									"    }\r",
									"};\r",
									"\r",
									"// Validate schema using tv4\r",
									"pm.test('Response matches product schema', function () {\r",
									"    pm.expect(tv4.validate(jsonData, schema)).to.be.true;\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
